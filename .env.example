# Auth switch
AUTH_ENABLED=false
NEXT_PUBLIC_AUTH_ENABLED=false

# Invitation code and Google login
INVITATION_CODE=change-me
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Whisper alignment
NCHC_WHISPER_API_KEY=
NCHC_WHISPER_MODEL=whisper-Breeze-ASR-25
NCHC_WHISPER_URL=https://portal.genai.nchc.org.tw/api/v1/audio/transcriptions

# Local OpenAI-compatible LLM (optional, for text-only steps such as Step 7.2)
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_API_KEY=replace-with-your-local-llm-key
LOCAL_LLM_MODEL=gemma-4-31B-it
LOCAL_LLM_LABEL=Gemma 4

# ===== Video Export (Step 4.1 / 7.1) =====
# Requires FFmpeg in container. Uses significant CPU/memory (min 2 vCPU / 2Gi).
# If SRT exists, the UI can optionally burn subtitles into the exported MP4.
VIDEO_EXPORT_ENABLED=false
NEXT_PUBLIC_VIDEO_EXPORT_ENABLED=false

# Max concurrent video exports (0 = auto-detect based on available memory)
# Recommended: 1 for 2Gi, 2 for 4Gi, 4 for 8Gi
VIDEO_MAX_CONCURRENT=0

# FFmpeg H.264 encoding preset (leave empty for auto-detect based on CPU count)
# Options: ultrafast | superfast | veryfast | faster | fast | medium | slow | slower | veryslow
# Auto: 1 vCPU → veryfast, 2 vCPU → fast, 4+ vCPU → medium
VIDEO_FFMPEG_PRESET=

# FFmpeg thread count (leave empty for auto: min(2, cpuCount))
# Set to 0 to let FFmpeg use all available cores (not recommended on shared hosts)
VIDEO_FFMPEG_THREADS=

# FFmpeg binary directory — LOCAL WINDOWS DEV ONLY (leave empty on Linux / Docker / Cloud Run)
# Set this if ffmpeg is not in PATH on your Windows machine.
# Example: C:\path\to\ffmpeg-8.1-full_build\bin
VIDEO_FFMPEG_BIN=

# ===== Usage Logging =====
# Docker: logs written to ./logs/usage.jsonl on the host (via volume mount)
# Cloud Run: leave empty — events are written to stdout and captured by Cloud Logging
LOG_FILE_PATH=/app/logs/usage.jsonl

# ===== TTS 分段生成（plan_I 方案 C）=====
# false = 停用（現況行為，不分段）
# true  = 啟用自動分段 + PCM 拼接，解決長篇破音問題
TTS_CHUNKING_ENABLED=false

# ===== TTS Chunk Audio Postprocessing =====
# Runs FFmpeg-based loudness analysis + conservative gain match + slide-boundary
# fade transition + final loudnorm on chunked TTS output. Only applies when
# TTS_CHUNKING_ENABLED=true and the script actually splits into >=2 chunks.
# Single-chunk fast path is untouched.
# Requires FFmpeg (VIDEO_FFMPEG_BIN on Windows, or `ffmpeg` in PATH inside Docker).
TTS_CHUNK_POSTPROCESSING_ENABLED=false

# Phase C slide transition parameters (tune by listening).
# Each chunk tail fades out, a silence gap is inserted, then the next chunk
# fades in. This gives a natural "turn the page" feel between slide chunks
# instead of a hard edit.
TTS_SLIDE_FADE_OUT_MS=100
TTS_SLIDE_SILENCE_MS=500
TTS_SLIDE_FADE_IN_MS=80
